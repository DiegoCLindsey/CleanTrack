rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isWhitelisted(email) {
      return exists(/databases/$(database)/documents/whitelist/$(email));
    }

    function isMember(listId) {
      return request.auth.token.email in
        get(/databases/$(database)/documents/lists/$(listId)).data.memberEmails;
    }

    // Whitelist: readable only by the owner of that email slot
    match /whitelist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // Lists
    match /lists/{listId} {
      allow read: if request.auth != null &&
        request.auth.token.email in resource.data.memberEmails;

      allow create: if request.auth != null &&
        isWhitelisted(request.auth.token.email) &&
        request.auth.token.email in request.resource.data.memberEmails;

      allow update: if request.auth != null &&
        request.auth.token.email in resource.data.memberEmails;

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && isMember(listId);
      }
    }
  }
}
